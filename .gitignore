# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Alembic / local DB artifacts
*.sqlite3
*.db

# IDE / OS
.idea/
*.swp
.DS_Store

# Logs
*.log
# Local-only, never committed
#   scratch/    local workspace; everything inside is ignored (plain names, no suffix needed)
#   *.local.*   opt any file out of commits elsewhere in the tree (e.g. docs/logbook.local.md)
scratch/
*.local.*
