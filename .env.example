# Moo-ternity Watch backend configuration.
# Copy to `.env` for local dev. All variables are prefixed with MW_.
# Values below are safe local defaults; replace secrets before any non-local deploy.

# local | test | staging | production
MW_ENVIRONMENT=local

# --- Database ---
MW_DATABASE_URL=postgresql+psycopg://moo:moo@localhost:5432/mooternity
# Separate database for the test suite (it creates/drops its own schema).
MW_TEST_DATABASE_URL=postgresql+psycopg://moo:moo@localhost:5432/mooternity_test

# --- Object storage (S3-compatible) ---
# Local dev uses an S3-compatible store on :9000 (see docker-compose.yml).
# Leave MW_S3_ENDPOINT_URL unset (empty) to use real AWS S3.
MW_S3_ENDPOINT_URL=http://localhost:9000
MW_S3_REGION=us-east-1
MW_S3_BUCKET=moo-snapshots
MW_S3_ACCESS_KEY_ID=minioadmin
MW_S3_SECRET_ACCESS_KEY=minioadmin
MW_SIGNED_URL_TTL_SECONDS=300

# --- Retention (open question in design doc) ---
MW_RETENTION_DAYS=90

# --- Twilio (SMS) ---
MW_TWILIO_ACCOUNT_SID=
MW_TWILIO_AUTH_TOKEN=
MW_TWILIO_FROM_NUMBER=

# --- Firebase Cloud Messaging (push) ---
MW_FCM_CREDENTIALS_JSON=

# --- Auth ---
MW_AUTH_SECRET=dev-insecure-change-me
MW_AUTH_TOKEN_TTL_SECONDS=3600
