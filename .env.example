# Moo-ternity Watch backend configuration.
# Copy to `.env` for local dev. All variables are prefixed with MW_.
# Values below are safe local defaults; replace secrets before any non-local deploy.

# local | test | staging | production
MW_ENVIRONMENT=local

# --- Database ---
MW_DATABASE_URL=postgresql+psycopg://moo:moo@localhost:5432/mooternity
# Separate database for the test suite (it creates/drops its own schema).
MW_TEST_DATABASE_URL=postgresql+psycopg://moo:moo@localhost:5432/mooternity_test

# --- Object storage (S3-compatible) ---
# Local dev uses an S3-compatible store on :9000 (see docker-compose.yml).
# Leave MW_S3_ENDPOINT_URL unset (empty) to use real AWS S3.
MW_S3_ENDPOINT_URL=http://localhost:9000
MW_S3_REGION=us-east-2
MW_S3_BUCKET=moo-snapshots
MW_S3_ACCESS_KEY_ID=minioadmin
MW_S3_SECRET_ACCESS_KEY=minioadmin
MW_SIGNED_URL_TTL_SECONDS=300

# --- Staging / production S3 profile (real AWS) ---
# For a real deploy, set MW_ENVIRONMENT=staging (or production) and switch the
# S3 settings to real AWS by LEAVING MW_S3_ENDPOINT_URL UNSET (comment it out or
# set it empty) so boto3 targets AWS S3 instead of the local mock:
#
#   MW_ENVIRONMENT=staging
#   # MW_S3_ENDPOINT_URL=            <- unset => real AWS S3
#   MW_S3_REGION=us-east-2
#   MW_S3_BUCKET=moo-snapshots-prod
#
# The backend runs on ECS Fargate with an attached task role (moo-backend), and
# boto3 picks up auto-rotating credentials from the provider chain, so no static
# S3 keys are needed in prod. See scratch/aws-setup.md (Part 2).
# NOTE: app/config.py currently *requires* MW_S3_ACCESS_KEY_ID / _SECRET to be
# non-empty in staging/production (it predates the task-role decision). Until
# that validator is relaxed, a key-less Fargate deploy would fail startup — see
# the open item in scratch/milestone-3-summary.md.

# --- Real-S3 test tier (opt-in; see tests/storage/test_s3_real.py) ---
# The `s3_real` pytest tier is SKIPPED unless this is "1". When enabled it needs
# AWS credentials (an OIDC role in CI, or a local profile) and MW_S3_ENDPOINT_URL
# must be UNSET so it runs against real AWS. It creates/destroys a throwaway
# bucket named moo-snapshots-citest-<id>; it never touches the real bucket.
MW_S3_REAL_TEST=0

# --- Retention (open question in design doc) ---
MW_RETENTION_DAYS=90

# --- Twilio (SMS) ---
MW_TWILIO_ACCOUNT_SID=
MW_TWILIO_AUTH_TOKEN=
MW_TWILIO_FROM_NUMBER=

# --- Firebase Cloud Messaging (push) ---
MW_FCM_CREDENTIALS_JSON=

# --- Auth ---
MW_AUTH_SECRET=dev-insecure-change-me
MW_AUTH_TOKEN_TTL_SECONDS=3600
